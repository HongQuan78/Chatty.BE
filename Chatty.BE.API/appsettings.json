{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RedisCache": {
    "Enabled": false,
    "Configuration": "localhost:6379",
    "InstanceName": "chatty:be:",
    "UserCacheSeconds": 300,
    "ConversationCacheSeconds": 120,
    "MessageCacheSeconds": 60
  },
  "AllowedHosts": "*"
}
